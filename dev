#!/usr/bin/env bash

# Lunch Cam developer commands for the paired iPhone.
#   dev install [--console] [--tint]
#                            Build, install and launch. Unlock the phone first.
#                            --console keeps showing the app's output; stopping it stops the app.
#                            --tint colors the two camera pictures (red F = front, green B = back),
#                            for Device Hub, where both cameras are black. Only for this launch.
#   dev photo [file]         Copy the last photo the app took to file (default: last.jpg).
#                            The app keeps that debug copy; delete this command when the copy goes.
#   dev test                 Run the inset geometry tests on this Mac. No phone needed.
set -euo pipefail
cd "$(dirname "$0")"
DEVICE="00008160-0001393420434036" # "iPhone Duo Max"
APP="com.vegerot.lunchcam"

case "${1:-}" in
install)
  # A generic destination builds while the phone is locked; only the install needs the phone.
  # The filter drops lines Xcode prints on every such build, which are not errors, and the
  # compiler command line it repeats after a compile error, which is thousands of characters.
  xcodebuild -project LunchCam.xcodeproj -scheme LunchCam -configuration Debug \
    -destination generic/platform=iOS -derivedDataPath build -allowProvisioningUpdates -quiet build 2>&1 |
    { grep --invert-match --extended-regexp 'IDESchemeActionsInvocationRecord|headermap|swift-frontend' || true; }
  xcrun devicectl device install app --device "$DEVICE" \
    build/Build/Products/Debug-iphoneos/LunchCam.app
  launch_options=() app_arguments=()
  for option in "${@:2}"; do
    case "$option" in
    --console) launch_options+=("$option") ;;
    --tint) app_arguments+=("$option") ;;
    *) echo "unknown option: $option" >&2 && exit 2 ;;
    esac
  done
  exec xcrun devicectl device process launch --device "$DEVICE" \
    --terminate-existing "${launch_options[@]}" "$APP" "${app_arguments[@]}"
  ;;
photo)
  file="${2:-last.jpg}"
  xcrun devicectl device copy from --device "$DEVICE" --domain-type appDataContainer \
    --domain-identifier "$APP" --source Documents/last.jpg --destination "$file" >/dev/null
  sips --getProperty pixelWidth --getProperty pixelHeight "$file"
  ;;
test)
  swiftc LunchCam/Inset.swift Tests/InsetTests.swift -o build/inset-tests
  exec build/inset-tests
  ;;
*)
  sed -n '3,11p' "$(basename "$0")" # the usage comment above; the `cd` put us next to the script
  exit 2
  ;;
esac
